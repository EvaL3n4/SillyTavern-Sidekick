{
    "name": "sillytavern-sidekick",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Sidekick — a dosage-style hero arc product for single-DM superhero campaigns.",
    "license": "AGPL-3.0-only",
    "author": "Eva",
    "keywords": [
        "sillytavern",
        "extension",
        "character-arc"
    ],
    "scripts": {
        "prepare": "husky",
        "test": "node --test test/*.test.js && node scripts/coverage.mjs",
        "lint": "eslint .",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.beads/**\" \"#.remember/**\" \"#AGENTS.md\"",
        "coverage": "node scripts/coverage.mjs",
        "lint-staged": "lint-staged"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "markdownlint-cli2": "^0.23.3"
    }
}
